From da4f5102e441ce5ccd93b550b35bd761f0e94013 Mon Sep 17 00:00:00 2001
From: =?UTF-8?q?Micha=C5=82=20Szczepaniak?= <m.szczepaniak.000@gmail.com>
Date: Thu, 20 Aug 2026 21:08:21 +0200
Subject: [PATCH] qml: skip re-establishing the GL sync point when reusing a
 frame

bind() already avoids re-locking (gst_video_frame_map) the buffer's
memory when redrawing the same already-mapped frame (e.g. repeated
repaints while paused), but was still unconditionally calling
gst_gl_sync_meta_set_sync_point()/gst_gl_sync_meta_wait() on every
single call regardless.

Both of those do a synchronous cross-thread dispatch
(gst_gl_context_thread_add()) onto the video memory's owning
GstGLContext's thread. There is nothing to (re-)synchronize when
reusing a frame that was already synced on its first bind() and
hasn't changed since, so skip both calls in that case too.

This matters beyond wasted work: diagnostic logging showed bind()
being invoked at a very high rate during redraw bursts, and each
call's two thread-add dispatches were flooding the GL context
thread's GMainContext, which in turn was hammering the reader lock
of a wl_display connection shared with the Qt Wayland platform
plugin - starving Qt's own event processing for multiple seconds at
a time.

Signed-off-by: Michal Szczepaniak <m.szczepaniak.000@gmail.com>
---
 .../gst-plugins-good/ext/qt/gstqsgmaterial.cc | 31 ++++++++++++++-----
 1 file changed, 23 insertions(+), 8 deletions(-)

diff --git a/subprojects/gst-plugins-good/ext/qt/gstqsgmaterial.cc b/subprojects/gst-plugins-good/ext/qt/gstqsgmaterial.cc
index b5aa6b14a9..1df5885f2c 100644
--- a/subprojects/gst-plugins-good/ext/qt/gstqsgmaterial.cc
+++ b/subprojects/gst-plugins-good/ext/qt/gstqsgmaterial.cc
@@ -493,6 +493,7 @@ GstQSGMaterial::bind(GstQSGMaterialShader *shader, GstVideoFormat v_format)
   GstMemory *mem;
   GstGLMemory *gl_mem;
   gboolean use_dummy_tex = TRUE;
+  gboolean reused_frame;
 
   if (this->v_frame.buffer && this->v_frame.buffer != this->buffer_) {
     gst_video_frame_unmap (&this->v_frame);
@@ -514,7 +515,9 @@ GstQSGMaterial::bind(GstQSGMaterialShader *shader, GstVideoFormat v_format)
 
   gl = qt_context->gl_vtable;
 
-  if (this->v_frame.buffer) {
+  reused_frame = this->v_frame.buffer != NULL;
+
+  if (reused_frame) {
     /* still mapped from a previous bind() of this same buffer (e.g. a
      * redraw while paused); reuse it instead of re-locking the memory */
     GST_LOG ("%p reusing already-mapped buffer with context %" GST_PTR_FORMAT, this, qt_context);
@@ -535,13 +538,25 @@ GstQSGMaterial::bind(GstQSGMaterialShader *shader, GstVideoFormat v_format)
 
   context = ((GstGLBaseMemory *)mem)->context;
 
-  sync_meta = gst_buffer_get_gl_sync_meta (this->sync_buffer_);
-  if (!sync_meta)
-    sync_meta = gst_buffer_add_gl_sync_meta (context, this->sync_buffer_);
-
-  gst_gl_sync_meta_set_sync_point (sync_meta, context);
-
-  gst_gl_sync_meta_wait (sync_meta, qt_context);
+  if (!reused_frame) {
+    /* the sync point only needs to be (re-)established once per unique
+     * buffer: it ensures GL commands that produced this frame have
+     * completed before we read from it. Re-doing this on every bind() of
+     * the *same* buffer (e.g. repeated redraws while paused) is not just
+     * wasted work - set_sync_point()/wait() each do a synchronous
+     * cross-thread dispatch onto the memory's owning GstGLContext, and
+     * doing that on every repaint can flood that context's thread with
+     * far more messages than it needs, starving other users of any
+     * connection/lock that context's thread also shares (e.g. the Qt
+     * Wayland platform plugin's Wayland display connection). */
+    sync_meta = gst_buffer_get_gl_sync_meta (this->sync_buffer_);
+    if (!sync_meta)
+      sync_meta = gst_buffer_add_gl_sync_meta (context, this->sync_buffer_);
+
+    gst_gl_sync_meta_set_sync_point (sync_meta, context);
+
+    gst_gl_sync_meta_wait (sync_meta, qt_context);
+  }
 
   if (this->v_frame.info.finfo->flags & GST_VIDEO_FORMAT_FLAG_YUV)
     initYuvShaders (shader, &this->v_frame.info.colorimetry);
-- 
